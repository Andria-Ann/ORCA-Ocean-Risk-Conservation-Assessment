# 02_insert_data.hbase
# Inserts 12 rows: 8 country-year rows (2010), 3 world production rows, 1 demo row.
# Run:  hbase shell 02_insert_data.hbase
#
# DATA LABELS (stored in info:data_status):
#   dataset_copy = values copied by hand from the project workbook (Datas.xlsx).
#                  They are not independently re-verified, and the 2010
#                  mismanaged-waste figures are modelled estimates, not
#                  direct ocean measurements.
#   illustrative = invented demo values with no real-world meaning.
# analysis:* values are a demo classification by this project (rule below).
#   mismanaged_waste_share_pct >= 5 -> HIGH ; >= 1 and < 5 -> MEDIUM ; < 1 -> LOW
# All values are written as quoted strings on purpose (see README, limitations).

# --- Australia (AUS#2010) ---
put 'marine_risk_ns:marine_risk', 'AUS#2010', 'info:country_name', 'Australia'
put 'marine_risk_ns:marine_risk', 'AUS#2010', 'info:iso3', 'AUS'
put 'marine_risk_ns:marine_risk', 'AUS#2010', 'info:year', '2010'
put 'marine_risk_ns:marine_risk', 'AUS#2010', 'info:record_type', 'country_year'
put 'marine_risk_ns:marine_risk', 'AUS#2010', 'info:source', 'workbook: mismanaged_waste + per_capita sheets'
put 'marine_risk_ns:marine_risk', 'AUS#2010', 'info:data_status', 'dataset_copy'
put 'marine_risk_ns:marine_risk', 'AUS#2010', 'metrics:mismanaged_waste_share_pct', '0.0436'
put 'marine_risk_ns:marine_risk', 'AUS#2010', 'metrics:per_capita_mismanaged', '0.002'
put 'marine_risk_ns:marine_risk', 'AUS#2010', 'metrics:per_capita_plastic_waste', '0.112'
put 'marine_risk_ns:marine_risk', 'AUS#2010', 'metrics:gdp_per_capita_ppp', '41464.04007'
put 'marine_risk_ns:marine_risk', 'AUS#2010', 'metrics:population', '22155000'
put 'marine_risk_ns:marine_risk', 'AUS#2010', 'analysis:mismanaged_risk_category', 'LOW'
put 'marine_risk_ns:marine_risk', 'AUS#2010', 'analysis:risk_basis', 'share_pct_threshold_v1'

